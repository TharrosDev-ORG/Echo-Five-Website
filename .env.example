# Contact form delivery (Resend — https://resend.com)
# Create an API key, verify the echo-five.ca sender domain, then set:
RESEND_API_KEY=
# Where enquiries are delivered:
CONTACT_TO_EMAIL=hello@echo-five.ca
# Verified sender (must be on a domain verified in Resend).
# Until the domain is verified you can use the Resend sandbox sender:
#   "Echo-Five <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Echo-Five <hello@echo-five.ca>"
